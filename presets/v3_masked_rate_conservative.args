# Conservative variant of @presets/v3_masked_rate.args, for the version that is
# easiest to defend in the thesis.
#
# Two restrictions relative to the full v3 preset:
#   --mask-rate-outside-weight 0.0  ignores the frame border the analyzer crops
#     away. The full preset flattens that border, which is a real bitrate saving
#     at zero accuracy cost, but a reader can call it exploiting the evaluation
#     crop rather than task-aware compression. Report both if you use it.
#   --mask-rate-target residual     penalizes only detail the preprocessor adds,
#     never detail it removes. This cannot lower bitrate below the anchor on its
#     own; it can only stop the enhancement-filter behaviour of earlier runs.

--preprocessor swin
--swin-qp-conditioning
--swin-qp-embed-dim 64
--max-residual 0.25

--codec h264
--codec-qps 30 35 40 45

--alpha 10
--rate-lambda 0.05
--distortion-reconstruction-weight 1.0

--ce-weight 1.0
--kd-weight 0.5
--kd-temperature 2.0
--feature-weight 0.05
--feature-layer layer4

--mask-rate-weight 1.0
--mask-rate-target residual
--mask-rate-layer layer4
--mask-rate-gamma 1.0
--mask-rate-outside-weight 0.0

--optimizer adamw
--weight-decay 0.01
--lr 0.0001
--clip-grad 1.0
--checkpoint-metric task_bd_rate
